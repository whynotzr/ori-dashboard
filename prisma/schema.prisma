generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GuildConfig {
  id              String   @id @default(cuid())
  guildId         String   @unique
  prefix          String   @default("/")
  modLogChannelId String?
  welcomeEnabled  Boolean  @default(true)
  welcomeMessage  String   @default("Bienvenue sur le serveur, {user} !")
  automodEnabled  Boolean  @default(true)
  xpMultiplier    Float    @default(1.0)
  aiModuleEnabled Boolean  @default(true)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  infractions     Infraction[]
}

model Infraction {
  id          String      @id @default(cuid())
  guildId     String
  targetId    String
  moderatorId String
  type        String
  reason      String
  createdAt   DateTime    @default(now())
  guild       GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, targetId])
}
